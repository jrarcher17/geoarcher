DATABASE_URL="postgresql://geoarcher:geoarcher@localhost:5433/geoarcher"

# Auth (generate secret: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
# Block new email/password registrations (existing users can still sign in)
DISABLE_SIGN_UP="true"

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5-mini"

# Billing (Stripe — Pro subscription)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID_PRO="price_..."
# ALLOW_DEV_BILLING="true"

# Legacy crawl caps (plan limits in src/lib/plans.ts take precedence at runtime)
MAX_CRAWL_PAGES="15"
COMPETITOR_MAX_CRAWL_PAGES="8"
# Remote browser — required in production (set on your host). Local Chromium in dev.
# CDP (recommended): connectOverCDP — use /chromium or /chrome
# BROWSERLESS_WS_URL="wss://production-sfo.browserless.io/chromium?token=..."
# Playwright native: chromium.connect — must include /playwright
# BROWSERLESS_WS_URL="wss://production-sfo.browserless.io/chromium/playwright?token=..."
# BROWSERLESS_CONNECT_TIMEOUT_MS="30000"
# Max Browserless *session* length (ms). Hobby plans max out at 60000 (1 min).
# BROWSERLESS_MAX_SESSION_MS="60000"
# BROWSERLESS_IN_DEV="true"
# FORCE_LOCAL_BROWSER="true"

# Phase 8 — weekly recrawl (POST /api/cron/recrawl with Authorization: Bearer ...)
# CRON_SECRET="generate-a-long-random-string"
# RECRAWL_INTERVAL_DAYS="7"
