generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id               String           @id @default(uuid())
  url              String           @unique
  geoKey           String           @unique @default(uuid())
  createdAt        DateTime         @default(now())
  scans            Scan[]
  geoConfig        GeoConfig?
  geoHits          GeoHit[]
  userSites        UserSite[]
  seoAudits        SeoAudit[]
  seoOpportunities SeoOpportunity[]
  seoLinkSuggestions     SeoLinkSuggestion[]
  seoSearchOpportunities SeoSearchOpportunity[]
  seoKeywords            SeoKeyword[]
  autopilotEnabled       Boolean                @default(false)
  autopilotRuns          AutopilotRun[]
}

model UserSite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([userId])
}

enum PlanTier {
  FREE
  PRO
  PRO_PLUS
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  plan                   PlanTier @default(FREE)
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  userSites     UserSite[]
  leadCampaigns LeadCampaign[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model GeoConfig {
  id           String   @id @default(uuid())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String   @unique
  enabled      Boolean  @default(false)
  jsonLd       Json     @default("[]")
  meta         Json     @default("{}")
  sourceScanId String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model GeoHit {
  id        String   @id @default(uuid())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  pageUrl   String
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

enum ScanStatus {
  QUEUED
  CRAWLING
  ANALYZING
  COMPLETE
  FAILED
}

model Scan {
  id              String      @id @default(uuid())
  site            Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId          String
  benchmarkScanId String?
  benchmarkScan   Scan?       @relation("BenchmarkCompetitors", fields: [benchmarkScanId], references: [id], onDelete: Cascade)
  competitorScans Scan[]      @relation("BenchmarkCompetitors")
  status          ScanStatus  @default(QUEUED)
  error           String?
  pagesCrawled    Int         @default(0)
  createdAt       DateTime    @default(now())
  finishedAt      DateTime?
  pages           Page[]
  analysis        Analysis?
  simulation      Simulation?
  visibility      VisibilityReport?
  seoAudit        SeoAudit?

  @@index([siteId, createdAt])
  @@index([benchmarkScanId])
}

model VisibilityReport {
  id         String           @id @default(uuid())
  scan       Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId     String           @unique
  status     SimulationStatus @default(RUNNING)
  error      String?
  results    Json?
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
}

enum SimulationStatus {
  RUNNING
  COMPLETE
  FAILED
}

model Simulation {
  id         String           @id @default(uuid())
  scan       Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId     String           @unique
  status     SimulationStatus @default(RUNNING)
  error      String?
  results    Json?
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
}

model Page {
  id              String  @id @default(uuid())
  scan            Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String
  url             String
  title           String?
  metaDescription String?
  canonicalUrl    String?
  statusCode      Int?
  wordCount       Int     @default(0)
  loadTimeMs      Int?
  extracted       Json

  @@index([scanId])
}

model Analysis {
  id              String   @id @default(uuid())
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String   @unique
  semanticMap     Json
  understanding   Json
  geoScore        Json
  contentGaps     Json
  recommendations Json
  createdAt       DateTime @default(now())
}

// ---- SEO Autopilot (Pro) ----
// Audits are derived from an existing Scan's crawled pages — no second crawl.

enum SeoAuditStatus {
  RUNNING
  COMPLETE
  FAILED
}

model SeoAudit {
  id             String         @id @default(uuid())
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId         String
  scan           Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId         String         @unique
  status         SeoAuditStatus @default(RUNNING)
  error          String?
  overallScore   Int?
  categoryScores Json?
  siteChecks     Json?
  contentPlan    Json?
  pageAudits     SeoPageAudit[]
  createdAt      DateTime       @default(now())
  finishedAt     DateTime?

  @@index([siteId, createdAt])
}

model SeoPageAudit {
  id      String   @id @default(uuid())
  audit   SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId String
  pageId  String?
  url     String
  score   Int
  issues  Json
  facts   Json

  @@index([auditId])
  @@index([auditId, score])
}

enum SeoOpportunityStatus {
  NEW
  REVIEWED
  APPROVED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model SeoOpportunity {
  id               String               @id @default(uuid())
  site             Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId           String
  auditId          String?
  category         String
  title            String
  description      String
  observed         String
  inferred         String
  impact           String
  difficulty       String
  opportunityScore Int
  contentType      String?
  affectedPages    Json                 @default("[]")
  source           String               @default("DETERMINISTIC")
  status           SeoOpportunityStatus @default(NEW)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([siteId, status])
  @@index([siteId, opportunityScore])
}

model SeoLinkSuggestion {
  id        String               @id @default(uuid())
  site      Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  auditId   String?
  fromUrl   String
  toUrl     String
  anchor    String
  relevance Int
  reason    String
  status    SeoOpportunityStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([siteId, fromUrl, toUrl])
  @@index([siteId, status])
}

enum AutopilotRunStatus {
  RUNNING
  COMPLETE
  FAILED
  STOPPED
}

model AutopilotRun {
  id            String             @id @default(uuid())
  site          Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId        String
  workflowRunId String?
  status        AutopilotRunStatus @default(RUNNING)
  /// Per-step outcomes: [{ step, status, detail }]
  steps         Json?
  /// Diff vs previous scan: { newPages, removedPages, changedPages }
  changes       Json?
  error         String?
  startedAt     DateTime           @default(now())
  finishedAt    DateTime?

  @@index([siteId, startedAt])
}

model SeoKeyword {
  id           String         @id @default(uuid())
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String
  keyword      String
  locationCode Int            @default(2840)
  languageCode String         @default("en")
  createdAt    DateTime       @default(now())
  checks       SeoRankCheck[]

  @@unique([siteId, keyword])
}

model SeoRankCheck {
  id         String     @id @default(uuid())
  keyword    SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  keywordId  String
  /// 1-based organic position; null = not found within checked depth
  position   Int?
  url        String?
  topResults Json?
  checkedAt  DateTime   @default(now())

  @@index([keywordId, checkedAt])
}

// ---- AI Lead Generation Machine (Pro Plus) ----

enum LeadCampaignMode {
  APPROVE_FIRST
  AUTO_SEND
}

enum LeadCampaignStatus {
  RUNNING
  PAUSED
  COMPLETE
  CANCELLED
  FAILED
}

enum ProspectStatus {
  FOUND
  ANALYZING
  QUALIFIED
  DISQUALIFIED
  CONTACTED
  REPLIED
  BOUNCED
  CLOSED
  FAILED
}

enum OutreachEmailStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  REPLIED
}

model LeadCampaign {
  id          String             @id @default(uuid())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  /// Apollo Organization Search inputs
  industry    String
  location    String?
  employeeMin Int?
  employeeMax Int?
  targetCount Int
  mode        LeadCampaignMode   @default(APPROVE_FIRST)
  status      LeadCampaignStatus @default(RUNNING)
  workflowId  String?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  prospects   Prospect[]

  @@index([userId, createdAt])
}

model Prospect {
  id             String          @id @default(uuid())
  campaign       LeadCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String
  companyName    String
  domain         String
  apolloOrgId    String?
  status         ProspectStatus  @default(FOUND)
  /// 0-100: higher = worse GEO/SEO = better prospect
  score          Int?
  scoreBreakdown Json?
  /// Problems found: [{ id, severity, title, detail }]
  problems       Json?
  /// Crawl summary facts used for report/outreach generation
  analysis       Json?
  contactName    String?
  contactTitle   String?
  contactEmail   String?
  /// Generated personalized report content (rendered at /r/[reportToken])
  report         Json?
  reportToken    String          @unique @default(uuid())
  error          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emails         OutreachEmail[]

  @@unique([campaignId, domain])
  @@index([campaignId, status])
  @@index([campaignId, score])
}

model OutreachEmail {
  id            String              @id @default(uuid())
  prospect      Prospect            @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId    String
  subject       String
  body          String
  status        OutreachEmailStatus @default(DRAFT)
  /// 0 = initial outreach, 1-2 = follow-ups
  followUpIndex Int                 @default(0)
  resendId      String?             @unique
  error         String?
  createdAt     DateTime            @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  openedAt      DateTime?
  bouncedAt     DateTime?
  repliedAt     DateTime?

  @@index([prospectId, followUpIndex])
}

/// Never email these addresses again (bounces, complaints, unsubscribes).
model EmailSuppression {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String
  createdAt DateTime @default(now())
}

model SeoSearchOpportunity {
  id               String               @id @default(uuid())
  site             Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId           String
  auditId          String?
  keyword          String
  intent           String
  demand           String
  competition      String
  existingUrl      String?
  recommendedUrl   String
  contentType      String?
  opportunityScore Int
  reason           String
  status           SeoOpportunityStatus @default(NEW)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([siteId, keyword])
  @@index([siteId, opportunityScore])
}
