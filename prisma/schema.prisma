generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id        String   @id @default(cuid())
  url       String   @unique
  createdAt DateTime @default(now())
  scans     Scan[]
}

enum ScanStatus {
  QUEUED
  CRAWLING
  ANALYZING
  COMPLETE
  FAILED
}

model Scan {
  id           String     @id @default(cuid())
  site         Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String
  status       ScanStatus @default(QUEUED)
  error        String?
  pagesCrawled Int        @default(0)
  createdAt    DateTime   @default(now())
  finishedAt   DateTime?
  pages        Page[]
  analysis     Analysis?
}

model Page {
  id              String  @id @default(cuid())
  scan            Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String
  url             String
  title           String?
  metaDescription String?
  canonicalUrl    String?
  statusCode      Int?
  wordCount       Int     @default(0)
  loadTimeMs      Int?
  extracted       Json

  @@index([scanId])
}

model Analysis {
  id              String   @id @default(cuid())
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String   @unique
  semanticMap     Json
  understanding   Json
  geoScore        Json
  contentGaps     Json
  recommendations Json
  createdAt       DateTime @default(now())
}
