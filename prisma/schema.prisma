generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id               String           @id @default(uuid())
  url              String           @unique
  geoKey           String           @unique @default(uuid())
  createdAt        DateTime         @default(now())
  scans            Scan[]
  geoConfig        GeoConfig?
  geoHits          GeoHit[]
  userSites        UserSite[]
  seoAudits        SeoAudit[]
  seoOpportunities SeoOpportunity[]
  seoLinkSuggestions     SeoLinkSuggestion[]
  seoSearchOpportunities SeoSearchOpportunity[]
  seoKeywords            SeoKeyword[]
  autopilotEnabled       Boolean                @default(false)
  autopilotRuns          AutopilotRun[]
  intelligence           SiteIntelligence?
  offerings              Offering[]
  siteImages             SiteImage[]
  adOpportunities        AdOpportunity[]
  adCampaigns            AdCampaign[]
}

model UserSite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([userId])
}

enum PlanTier {
  FREE
  PRO
  PRO_PLUS
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  plan                   PlanTier @default(FREE)
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  userSites     UserSite[]
  leadCampaigns LeadCampaign[]
  adCampaigns           AdCampaign[]
  adPlatformConnections AdPlatformConnection[]
  aiActions             AIAction[]
  aiRecommendations     AIRecommendation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model GeoConfig {
  id           String   @id @default(uuid())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String   @unique
  enabled      Boolean  @default(false)
  jsonLd       Json     @default("[]")
  meta         Json     @default("{}")
  sourceScanId String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model GeoHit {
  id        String   @id @default(uuid())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  pageUrl   String
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

enum ScanStatus {
  QUEUED
  CRAWLING
  ANALYZING
  COMPLETE
  FAILED
}

model Scan {
  id              String      @id @default(uuid())
  site            Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId          String
  benchmarkScanId String?
  benchmarkScan   Scan?       @relation("BenchmarkCompetitors", fields: [benchmarkScanId], references: [id], onDelete: Cascade)
  competitorScans Scan[]      @relation("BenchmarkCompetitors")
  status          ScanStatus  @default(QUEUED)
  error           String?
  pagesCrawled    Int         @default(0)
  createdAt       DateTime    @default(now())
  finishedAt      DateTime?
  pages           Page[]
  analysis        Analysis?
  simulation      Simulation?
  visibility      VisibilityReport?
  seoAudit        SeoAudit?

  @@index([siteId, createdAt])
  @@index([benchmarkScanId])
}

model VisibilityReport {
  id         String           @id @default(uuid())
  scan       Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId     String           @unique
  status     SimulationStatus @default(RUNNING)
  error      String?
  results    Json?
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
}

enum SimulationStatus {
  RUNNING
  COMPLETE
  FAILED
}

model Simulation {
  id         String           @id @default(uuid())
  scan       Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId     String           @unique
  status     SimulationStatus @default(RUNNING)
  error      String?
  results    Json?
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
}

model Page {
  id              String  @id @default(uuid())
  scan            Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String
  url             String
  title           String?
  metaDescription String?
  canonicalUrl    String?
  statusCode      Int?
  wordCount       Int     @default(0)
  loadTimeMs      Int?
  extracted       Json

  @@index([scanId])
}

model Analysis {
  id              String   @id @default(uuid())
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String   @unique
  semanticMap     Json
  understanding   Json
  geoScore        Json
  contentGaps     Json
  recommendations Json
  createdAt       DateTime @default(now())
}

// ---- SEO Autopilot (Pro) ----
// Audits are derived from an existing Scan's crawled pages — no second crawl.

enum SeoAuditStatus {
  RUNNING
  COMPLETE
  FAILED
}

model SeoAudit {
  id             String         @id @default(uuid())
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId         String
  scan           Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId         String         @unique
  status         SeoAuditStatus @default(RUNNING)
  error          String?
  overallScore   Int?
  categoryScores Json?
  siteChecks     Json?
  contentPlan    Json?
  pageAudits     SeoPageAudit[]
  createdAt      DateTime       @default(now())
  finishedAt     DateTime?

  @@index([siteId, createdAt])
}

model SeoPageAudit {
  id      String   @id @default(uuid())
  audit   SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId String
  pageId  String?
  url     String
  score   Int
  issues  Json
  facts   Json

  @@index([auditId])
  @@index([auditId, score])
}

enum SeoOpportunityStatus {
  NEW
  REVIEWED
  APPROVED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model SeoOpportunity {
  id               String               @id @default(uuid())
  site             Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId           String
  auditId          String?
  category         String
  title            String
  description      String
  observed         String
  inferred         String
  impact           String
  difficulty       String
  opportunityScore Int
  contentType      String?
  affectedPages    Json                 @default("[]")
  source           String               @default("DETERMINISTIC")
  status           SeoOpportunityStatus @default(NEW)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([siteId, status])
  @@index([siteId, opportunityScore])
}

model SeoLinkSuggestion {
  id        String               @id @default(uuid())
  site      Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  auditId   String?
  fromUrl   String
  toUrl     String
  anchor    String
  relevance Int
  reason    String
  status    SeoOpportunityStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([siteId, fromUrl, toUrl])
  @@index([siteId, status])
}

enum AutopilotRunStatus {
  RUNNING
  COMPLETE
  FAILED
  STOPPED
}

model AutopilotRun {
  id            String             @id @default(uuid())
  site          Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId        String
  workflowRunId String?
  status        AutopilotRunStatus @default(RUNNING)
  /// Per-step outcomes: [{ step, status, detail }]
  steps         Json?
  /// Diff vs previous scan: { newPages, removedPages, changedPages }
  changes       Json?
  error         String?
  startedAt     DateTime           @default(now())
  finishedAt    DateTime?

  @@index([siteId, startedAt])
}

model SeoKeyword {
  id           String         @id @default(uuid())
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String
  keyword      String
  locationCode Int            @default(2840)
  languageCode String         @default("en")
  createdAt    DateTime       @default(now())
  checks       SeoRankCheck[]

  @@unique([siteId, keyword])
}

model SeoRankCheck {
  id         String     @id @default(uuid())
  keyword    SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  keywordId  String
  /// 1-based organic position; null = not found within checked depth
  position   Int?
  url        String?
  topResults Json?
  checkedAt  DateTime   @default(now())

  @@index([keywordId, checkedAt])
}

// ---- AI Lead Generation Machine (Pro Plus) ----

enum LeadCampaignMode {
  APPROVE_FIRST
  AUTO_SEND
}

enum LeadCampaignStatus {
  RUNNING
  PAUSED
  COMPLETE
  CANCELLED
  FAILED
}

enum ProspectStatus {
  FOUND
  ANALYZING
  QUALIFIED
  DISQUALIFIED
  CONTACTED
  REPLIED
  BOUNCED
  CLOSED
  FAILED
}

enum OutreachEmailStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  REPLIED
}

model LeadCampaign {
  id          String             @id @default(uuid())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  /// Apollo Organization Search inputs
  industry    String
  location    String?
  employeeMin Int?
  employeeMax Int?
  targetCount Int
  mode        LeadCampaignMode   @default(APPROVE_FIRST)
  status      LeadCampaignStatus @default(RUNNING)
  workflowId  String?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  prospects   Prospect[]

  @@index([userId, createdAt])
}

model Prospect {
  id             String          @id @default(uuid())
  campaign       LeadCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String
  companyName    String
  domain         String
  apolloOrgId    String?
  status         ProspectStatus  @default(FOUND)
  /// 0-100: higher = worse GEO/SEO = better prospect
  score          Int?
  scoreBreakdown Json?
  /// Problems found: [{ id, severity, title, detail }]
  problems       Json?
  /// Crawl summary facts used for report/outreach generation
  analysis       Json?
  contactName    String?
  contactTitle   String?
  contactEmail   String?
  /// Generated personalized report content (rendered at /r/[reportToken])
  report         Json?
  reportToken    String          @unique @default(uuid())
  error          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emails         OutreachEmail[]
  adCampaigns    AdCampaign[]

  @@unique([campaignId, domain])
  @@index([campaignId, status])
  @@index([campaignId, score])
}

model OutreachEmail {
  id            String              @id @default(uuid())
  prospect      Prospect            @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId    String
  subject       String
  body          String
  status        OutreachEmailStatus @default(DRAFT)
  /// 0 = initial outreach, 1-2 = follow-ups
  followUpIndex Int                 @default(0)
  resendId      String?             @unique
  error         String?
  createdAt     DateTime            @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  openedAt      DateTime?
  bouncedAt     DateTime?
  repliedAt     DateTime?

  @@index([prospectId, followUpIndex])
}

/// Never email these addresses again (bounces, complaints, unsubscribes).
model EmailSuppression {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String
  createdAt DateTime @default(now())
}

// ---- AI Advertising Command Center ----
// The scan is the intelligence source: business profile, offerings (products/
// services), images and marketing assets extracted from crawled pages power
// Ad Studio, campaigns and lead-gen advertising opportunity scoring.

enum IntelligenceStatus {
  RUNNING
  COMPLETE
  FAILED
}

/// AI business profile + marketing assets extracted from a site's scan.
model SiteIntelligence {
  id     String             @id @default(uuid())
  site   Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String             @unique
  /// Scan the intelligence was derived from
  scanId String?
  status IntelligenceStatus @default(RUNNING)
  error  String?
  /// { companyName, description, industry, locations[], phone, email, address }
  business  Json?
  /// { headlines[], valueProps[], ctas[], promotions[], testimonials[], trustSignals[], usps[], faqs[] }
  marketing Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OfferingKind {
  PRODUCT
  SERVICE
}

/// A product or service identified on the website — the advertisable unit.
model Offering {
  id          String       @id @default(uuid())
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  kind        OfferingKind
  name        String
  description String
  /// Price as found on the site (verbatim string); never invented
  price       String?
  url         String?
  /// { benefits[], features[], cta, location }
  details     Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      SiteImage[]
  opportunities AdOpportunity[]
  adCampaigns   AdCampaign[]

  @@unique([siteId, name])
  @@index([siteId, kind])
}

/// Useful image discovered on the website, selectable as ad creative.
model SiteImage {
  id         String    @id @default(uuid())
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId     String
  offering   Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  offeringId String?
  url        String
  alt        String?
  pageUrl    String?
  width      Int?
  height     Int?
  createdAt  DateTime  @default(now())

  @@unique([siteId, url])
  @@index([siteId])
}

enum OpportunityLevel {
  HIGH
  MEDIUM
  LOW
}

/// An advertising opportunity the AI identified for a site's offering.
model AdOpportunity {
  id         String           @id @default(uuid())
  site       Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId     String
  offering   Offering?        @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringId String?
  title      String
  level      OpportunityLevel
  rationale  String
  /// e.g. ["google", "meta", "ai"]
  channels   Json             @default("[]")
  /// AI-recommended campaign starting point: { name, goal, budgetHint, audience }
  recommendedCampaign Json?
  dismissed  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([siteId, level])
}

enum AdPlatform {
  GOOGLE
  META
  AI_CHAT
}

enum AdCampaignGoal {
  LEADS
  SALES
  TRAFFIC
  PHONE_CALLS
  AWARENESS
}

enum AdCampaignStatus {
  DRAFT
  READY
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  ERROR
}

/// One advertising campaign on one platform (Ad Studio may create several).
model AdCampaign {
  id         String           @id @default(uuid())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  site       Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId     String?
  offering   Offering?        @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  offeringId String?
  /// Set when the campaign originated from a lead-gen prospect
  prospect   Prospect?        @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId String?
  platform   AdPlatform
  status     AdCampaignStatus @default(DRAFT)
  name       String
  goal       AdCampaignGoal
  landingPage String?
  /// Daily budget in cents
  budgetDailyCents Int?
  currency         String  @default("USD")
  /// Geographic targeting: [{ name, type }]
  locations Json @default("[]")
  /// AI audience recommendation: { description, segments[], ageRange, interests[] }
  audience  Json?
  /// Platform-specific structure (Google: ad groups/keywords; Meta: ad sets)
  structure Json?
  /// Platform campaign id once actually published (never faked)
  externalId String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  publishedAt DateTime?
  ads        Ad[]
  metrics    CampaignMetric[]

  @@index([userId, createdAt])
  @@index([siteId, status])
  @@index([userId, status])
}

enum CreativeSource {
  SITE_IMAGE
  UPLOAD
  GENERATED
  NONE
}

/// An individual ad inside a campaign.
model Ad {
  id          String     @id @default(uuid())
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String
  name        String?
  /// Ad copy: { headlines[], descriptions[], primaryText, cta, keywords[] }
  copy        Json
  destinationUrl String?
  creativeSource CreativeSource @default(NONE)
  /// { url, alt, width, height, siteImageId }
  creative    Json?
  externalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  metrics     AdMetric[]

  @@index([campaignId])
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// OAuth connection to an advertising platform. Tokens are encrypted at rest
/// and never sent to the browser.
model AdPlatformConnection {
  id          String           @id @default(uuid())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  platform    AdPlatform
  status      ConnectionStatus @default(DISCONNECTED)
  accountId   String?
  accountName String?
  /// Encrypted (AES-256-GCM) — never exposed to the client
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scopes       String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, platform])
}

/// Daily performance snapshot for a campaign (synced from the platform).
model CampaignMetric {
  id          String     @id @default(uuid())
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String
  date        DateTime   @db.Date
  spendCents  Int        @default(0)
  impressions Int        @default(0)
  clicks      Int        @default(0)
  conversions Int        @default(0)
  revenueCents Int       @default(0)

  @@unique([campaignId, date])
  @@index([campaignId, date])
}

/// Daily performance snapshot for an individual ad.
model AdMetric {
  id          String   @id @default(uuid())
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId        String
  date        DateTime @db.Date
  spendCents  Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)

  @@unique([adId, date])
}

enum AIActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

/// Audit trail for AI-initiated actions. Spend-changing actions require
/// explicit user approval before execution.
model AIAction {
  id         String         @id @default(uuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  action     String
  platform   AdPlatform?
  campaignId String?
  previousValue Json?
  newValue      Json?
  status     AIActionStatus @default(PENDING)
  approvedBy String?
  error      String?
  createdAt  DateTime  @default(now())
  executedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, status])
}

enum AIRecommendationStatus {
  NEW
  REVIEWED
  APPLIED
  DISMISSED
}

/// AI performance recommendation surfaced on the dashboard/analytics.
model AIRecommendation {
  id         String                 @id @default(uuid())
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  campaignId String?
  type       String
  title      String
  detail     String
  /// Structured payload for one-click apply (e.g. { budgetDailyCents: 4600 })
  payload    Json?
  status     AIRecommendationStatus @default(NEW)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([userId, status])
}

model SeoSearchOpportunity {
  id               String               @id @default(uuid())
  site             Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId           String
  auditId          String?
  keyword          String
  intent           String
  demand           String
  competition      String
  existingUrl      String?
  recommendedUrl   String
  contentType      String?
  opportunityScore Int
  reason           String
  status           SeoOpportunityStatus @default(NEW)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([siteId, keyword])
  @@index([siteId, opportunityScore])
}
