generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id               String           @id @default(uuid())
  url              String           @unique
  geoKey           String           @unique @default(cuid())
  createdAt        DateTime         @default(now())
  scans            Scan[]
  geoConfig        GeoConfig?
  geoHits          GeoHit[]
  userSites        UserSite[]
  seoAudits        SeoAudit[]
  seoOpportunities SeoOpportunity[]
  seoLinkSuggestions     SeoLinkSuggestion[]
  seoSearchOpportunities SeoSearchOpportunity[]
  seoKeywords            SeoKeyword[]
}

model UserSite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([userId])
}

enum PlanTier {
  FREE
  PRO
}

model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  plan                   PlanTier @default(FREE)
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  userSites     UserSite[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model GeoConfig {
  id           String   @id @default(cuid())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String   @unique
  enabled      Boolean  @default(false)
  jsonLd       Json     @default("[]")
  meta         Json     @default("{}")
  sourceScanId String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model GeoHit {
  id        String   @id @default(cuid())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  pageUrl   String
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

enum ScanStatus {
  QUEUED
  CRAWLING
  ANALYZING
  COMPLETE
  FAILED
}

model Scan {
  id              String      @id @default(uuid())
  site            Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId          String
  benchmarkScanId String?
  benchmarkScan   Scan?       @relation("BenchmarkCompetitors", fields: [benchmarkScanId], references: [id], onDelete: Cascade)
  competitorScans Scan[]      @relation("BenchmarkCompetitors")
  status          ScanStatus  @default(QUEUED)
  error           String?
  pagesCrawled    Int         @default(0)
  createdAt       DateTime    @default(now())
  finishedAt      DateTime?
  pages           Page[]
  analysis        Analysis?
  simulation      Simulation?
  visibility      VisibilityReport?
  seoAudit        SeoAudit?

  @@index([siteId, createdAt])
  @@index([benchmarkScanId])
}

model VisibilityReport {
  id         String           @id @default(cuid())
  scan       Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId     String           @unique
  status     SimulationStatus @default(RUNNING)
  error      String?
  results    Json?
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
}

enum SimulationStatus {
  RUNNING
  COMPLETE
  FAILED
}

model Simulation {
  id         String           @id @default(cuid())
  scan       Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId     String           @unique
  status     SimulationStatus @default(RUNNING)
  error      String?
  results    Json?
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
}

model Page {
  id              String  @id @default(cuid())
  scan            Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String
  url             String
  title           String?
  metaDescription String?
  canonicalUrl    String?
  statusCode      Int?
  wordCount       Int     @default(0)
  loadTimeMs      Int?
  extracted       Json

  @@index([scanId])
}

model Analysis {
  id              String   @id @default(cuid())
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String   @unique
  semanticMap     Json
  understanding   Json
  geoScore        Json
  contentGaps     Json
  recommendations Json
  createdAt       DateTime @default(now())
}

// ---- SEO Autopilot (Pro) ----
// Audits are derived from an existing Scan's crawled pages — no second crawl.

enum SeoAuditStatus {
  RUNNING
  COMPLETE
  FAILED
}

model SeoAudit {
  id             String         @id @default(cuid())
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId         String
  scan           Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId         String         @unique
  status         SeoAuditStatus @default(RUNNING)
  error          String?
  overallScore   Int?
  categoryScores Json?
  siteChecks     Json?
  contentPlan    Json?
  pageAudits     SeoPageAudit[]
  createdAt      DateTime       @default(now())
  finishedAt     DateTime?

  @@index([siteId, createdAt])
}

model SeoPageAudit {
  id      String   @id @default(cuid())
  audit   SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId String
  pageId  String?
  url     String
  score   Int
  issues  Json
  facts   Json

  @@index([auditId])
  @@index([auditId, score])
}

enum SeoOpportunityStatus {
  NEW
  REVIEWED
  APPROVED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model SeoOpportunity {
  id               String               @id @default(cuid())
  site             Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId           String
  auditId          String?
  category         String
  title            String
  description      String
  observed         String
  inferred         String
  impact           String
  difficulty       String
  opportunityScore Int
  contentType      String?
  affectedPages    Json                 @default("[]")
  source           String               @default("DETERMINISTIC")
  status           SeoOpportunityStatus @default(NEW)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([siteId, status])
  @@index([siteId, opportunityScore])
}

model SeoLinkSuggestion {
  id        String               @id @default(cuid())
  site      Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  auditId   String?
  fromUrl   String
  toUrl     String
  anchor    String
  relevance Int
  reason    String
  status    SeoOpportunityStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([siteId, fromUrl, toUrl])
  @@index([siteId, status])
}

model SeoKeyword {
  id           String         @id @default(cuid())
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String
  keyword      String
  locationCode Int            @default(2840)
  languageCode String         @default("en")
  createdAt    DateTime       @default(now())
  checks       SeoRankCheck[]

  @@unique([siteId, keyword])
}

model SeoRankCheck {
  id         String     @id @default(cuid())
  keyword    SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  keywordId  String
  /// 1-based organic position; null = not found within checked depth
  position   Int?
  url        String?
  topResults Json?
  checkedAt  DateTime   @default(now())

  @@index([keywordId, checkedAt])
}

model SeoSearchOpportunity {
  id               String               @id @default(cuid())
  site             Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId           String
  auditId          String?
  keyword          String
  intent           String
  demand           String
  competition      String
  existingUrl      String?
  recommendedUrl   String
  contentType      String?
  opportunityScore Int
  reason           String
  status           SeoOpportunityStatus @default(NEW)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([siteId, keyword])
  @@index([siteId, opportunityScore])
}
